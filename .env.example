# Copy to .env and adjust. docker-compose reads these automatically.

# --- Models (plain Ollama tags, pulled automatically on first start) ---
# DESCRIBER_MODEL is stage 1 and MUST support vision (it sees the image).
# DECISION_MODEL is stage 2 and only reads text.
# Using the SAME tag for both means Ollama loads one model = no swapping = fastest.
DESCRIBER_MODEL=gemma4:e2b
DECISION_MODEL=gemma4:e2b

# Optional: extra tags to pre-pull at boot (space-separated), e.g. to A/B test.
# EXTRA_MODELS=gemma4:e4b

# --- Classification tuning ---
THRESHOLD=0.8        # below this confidence -> "uncertain" (flagged, blocked by default)
TEMPERATURE=0        # 0 = most deterministic
MAX_DIM=1536         # images are downscaled to this longest edge before inference

# --- Load handling / queue ---
CLASSIFY_CONCURRENCY=1        # images processed at once (CPU: 1 = predictable latency)
QUEUE_MAX=32                 # max active+waiting before new requests get 503 (retry)
MAX_UPLOAD_BYTES=26214400    # per-image upload cap (bytes); larger -> 413

# --- Networking ---
BOUNCER_PORT=8080 # host port for the API + demo UI

# --- Where Ollama runs (default: inside the container, CPU) ---
# Apple Silicon GPU: run Ollama natively on the Mac
#   (OLLAMA_HOST=0.0.0.0:11434 ollama serve)
# then uncomment the next line — the container will use the Mac's Metal-accelerated
# Ollama instead of starting its own:
# OLLAMA_URL=http://host.docker.internal:11434
